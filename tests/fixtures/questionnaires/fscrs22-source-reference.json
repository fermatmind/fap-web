  "questions": [
    {
      "id": "fscrs-01",
      "sourceNumber": 1,
      "text": {
        "en": "I am easily disappointed with myself.",
        "zh": "我很容易对自己失望。"
      },
      "part": "inadequate",
      "sensitive": false
    },
    {
      "id": "fscrs-02",
      "sourceNumber": 2,
      "text": {
        "en": "There is a part of me that puts me down.",
        "zh": "我内心有一部分在贬低自己。"
      },
      "part": "inadequate",
      "sensitive": false
    },
    {
      "id": "fscrs-03",
      "sourceNumber": 3,
      "text": {
        "en": "I am able to remind myself of positive things about myself.",
        "zh": "我能够提醒自己，自己也有积极的一面。"
      },
      "part": "reassured",
      "sensitive": false
    },
    {
      "id": "fscrs-04",
      "sourceNumber": 4,
      "text": {
        "en": "I find it difficult to control my anger and frustration at myself.",
        "zh": "我很难控制对自己产生的愤怒和挫败感。"
      },
      "part": "inadequate",
      "sensitive": false
    },
    {
      "id": "fscrs-05",
      "sourceNumber": 5,
      "text": {
        "en": "I find it easy to forgive myself.",
        "zh": "我觉得原谅自己并不难。"
      },
      "part": "reassured",
      "sensitive": false
    },
    {
      "id": "fscrs-06",
      "sourceNumber": 6,
      "text": {
        "en": "There is a part of me that feels I am not good enough.",
        "zh": "我内心有一部分觉得自己不够好。"
      },
      "part": "inadequate",
      "sensitive": false
    },
    {
      "id": "fscrs-07",
      "sourceNumber": 7,
      "text": {
        "en": "I feel beaten down by my own self-critical thoughts.",
        "zh": "自我批评的想法让我感到备受打击。"
      },
      "part": "inadequate",
      "sensitive": false
    },
    {
      "id": "fscrs-08",
      "sourceNumber": 8,
      "text": {
        "en": "I still like being me.",
        "zh": "我仍然喜欢自己。"
      },
      "part": "reassured",
      "sensitive": false
    },
    {
      "id": "fscrs-09",
      "sourceNumber": 9,
      "text": {
        "en": "I have become so angry with myself that I want to hurt or injure myself.",
        "zh": "我对自己愤怒到了想伤害自己的地步。"
      },
      "part": "hated",
      "sensitive": true
    },
    {
      "id": "fscrs-10",
      "sourceNumber": 10,
      "text": {
        "en": "I have a sense of disgust with myself.",
        "zh": "我对自己有一种厌恶感。"
      },
      "part": "hated",
      "sensitive": false
    },
    {
      "id": "fscrs-11",
      "sourceNumber": 11,
      "text": {
        "en": "I can still feel lovable and acceptable.",
        "zh": "我仍能觉得自己是能被爱、能被接纳的人。"
      },
      "part": "reassured",
      "sensitive": false
    },
    {
      "id": "fscrs-12",
      "sourceNumber": 12,
      "text": {
        "en": "I stop caring about myself.",
        "zh": "我不再关心自己。"
      },
      "part": "hated",
      "sensitive": false
    },
    {
      "id": "fscrs-13",
      "sourceNumber": 13,
      "text": {
        "en": "I find it easy to like myself.",
        "zh": "我觉得喜欢自己并不难。"
      },
      "part": "reassured",
      "sensitive": false
    },
    {
      "id": "fscrs-14",
      "sourceNumber": 14,
      "text": {
        "en": "I remember and dwell on my failings.",
        "zh": "我会回想自己的不足，并反复纠结于此。"
      },
      "part": "inadequate",
      "sensitive": false
    },
    {
      "id": "fscrs-15",
      "sourceNumber": 15,
      "text": {
        "en": "I call myself names.",
        "zh": "我会用贬损的话称呼自己。"
      },
      "part": "hated",
      "sensitive": false
    },
    {
      "id": "fscrs-16",
      "sourceNumber": 16,
      "text": {
        "en": "I am gentle and supportive with myself.",
        "zh": "我会温和地对待自己，并支持自己。"
      },
      "part": "reassured",
      "sensitive": false
    },
    {
      "id": "fscrs-17",
      "sourceNumber": 17,
      "text": {
        "en": "I can’t accept failures and setbacks without feeling inadequate.",
        "zh": "在接受失败或挫折时，我很难不觉得自己不够好。"
      },
      "part": "inadequate",
      "sensitive": false
    },
    {
      "id": "fscrs-18",
      "sourceNumber": 18,
      "text": {
        "en": "I think I deserve my self-criticism.",
        "zh": "我觉得自己理应受到自己的批评。"
      },
      "part": "inadequate",
      "sensitive": false
    },
    {
      "id": "fscrs-19",
      "sourceNumber": 19,
      "text": {
        "en": "I am able to care and look after myself.",
        "zh": "我能够关心并照顾自己。"
      },
      "part": "reassured",
      "sensitive": false
    },
    {
      "id": "fscrs-20",
      "sourceNumber": 20,
      "text": {
        "en": "There is a part of me that wants to get rid of the bits I don’t like.",
        "zh": "我内心的一部分想摆脱自己身上那些我不喜欢的方面。"
      },
      "part": "inadequate",
      "sensitive": false
    },
    {
      "id": "fscrs-21",
      "sourceNumber": 21,
      "text": {
        "en": "I encourage myself for the future.",
        "zh": "我会鼓励自己面对未来。"
      },
      "part": "reassured",
      "sensitive": false
    },
    {
      "id": "fscrs-22",
      "sourceNumber": 22,
      "text": {
        "en": "I do not like being me.",
        "zh": "我不喜欢自己。"
      },
      "part": "hated",
      "sensitive": false
    }
  ],
