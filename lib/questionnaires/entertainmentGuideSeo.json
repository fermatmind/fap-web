  "rice-purity-test": {
    "quiz": {
      "zh": "纯洁度测试（Rice Purity）",
      "en": "Rice Purity Test"
    },
    "names": {
      "score-reading": {
        "name": {
          "zh": "Rice Purity分数读法",
          "en": "Reading a Rice Purity score"
        },
        "topic": {
          "zh": "理解0—100分、跳过项目、版本差异与分享边界。",
          "en": "Understand the 0–100 score, skipped items, edition differences and sharing boundaries."
        },
        "presentation": {
          "title": {
            "zh": "Rice Purity分数含义：计算、跳过与版本",
            "en": "Rice Purity Score Meaning: Calculation & Skipped Items"
          },
          "summary": {
            "zh": "本版纯洁度分数等于100减去本轮勾选项数。勾选3项得97分；未勾选可能表示未经历或选择跳过。本指南说明0—100分、原创版本与分享边界，不以分数评价道德或完整经历。",
            "en": "In this edition, your Rice Purity score is 100 minus the number of checked items. Three checked items give 97; unchecked items may mean not experienced or skipped. Read the 0–100 calculation, edition differences and sharing limits without ranking morality or life experience."
          },
          "seo": {
            "title": {
              "zh": "Rice Purity分数含义：计算、跳过与版本",
              "en": "Rice Purity Score Meaning: Calculation & Skipped Items"
            },
            "description": {
              "en": "Rice Purity score meaning: 100 minus checked items. Learn how skips, 0–100 scores and edition differences work in this independent 100-item checklist.",
              "zh": "Rice Purity纯洁度分数含义：100减去勾选数。了解0—100分、未经历与跳过、原创版本差异和分享边界，不以分数评判道德。"
