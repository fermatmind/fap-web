{
  "schema_version": "fermatmind.public_topic_edge_renderer.proposal.v1",
  "status": "IMPLEMENTED_RUNTIME_CALLSITES_NOT_DEPLOYMENT_PROVEN",
  "design_only": false,
  "authority": "consume fap-api public API only",
  "backend_projection": {
    "endpoint": "/api/v0.5/public-topic-edges?source_type={type}&source_id={id}&locale={locale}",
    "schema_version": "public-topic-edges.v1",
    "authority_version": "cms-public-topic-edge-authority.v1",
    "source_canonical_readback_required": true,
    "cross_locale_approval_field": "cross_locale_approved",
    "authority_unavailable": "503 AUTHORITY_UNAVAILABLE with empty items",
    "career_link_publication_gate": "CLOSED"
  },
  "rendering": {
    "SSR_visible_HTML": true,
    "deterministic": "same validated payload yields byte-stable ordered anchor structure",
    "ordering": "preserve backend position then stable identity tiebreaker",
    "no_slug_inference": true,
    "no_local_mapping": true,
    "no_editorial_copy": true,
    "empty_payload": "render no module or minimal non-editorial shell",
    "api_error": "explicitly unavailable/no module; never pretend success",
    "canonical_hreflang_metadata_unchanged": true,
    "tracking_parameters_excluded_from_canonical": true,
    "locale_mismatch_fail_closed": "unless explicit backend cross_locale_approved=true and canonical/locale validation passes",
    "private_target_fail_closed": true,
    "career_gate": "do not render until current C06 passes"
  },
  "validation": [
    "deterministic order",
    "duplicate edge",
    "invalid relation",
    "exact item/authority source canonical equality",
    "missing target",
    "inactive target",
    "unqualified target",
    "locale mismatch",
    "private target",
    "empty API",
    "API timeout and 503 AUTHORITY_UNAVAILABLE",
    "no local fallback",
    "safe tracking payload",
    "tracking query absent from canonical",
    "Career gate",
    "server-rendered visible links"
  ],
  "tracking_requirement": {
    "status": "M06_PUBLIC_TOPIC_EDGE_CLICK_RUNTIME_IMPLEMENTED_NOT_DEPLOYMENT_PROVEN",
    "m06_source": "window-02-measurement/event_contract.json",
    "m06_contract_status": "IMPLEMENTED_RUNTIME_CALLSITE_NOT_DEPLOYMENT_PROVEN",
    "event_name": "public_topic_edge_click",
    "observation_class": "browser_observation",
    "trigger_semantics": "A user activates a rendered public edge that was approved and issued by the backend authority.",
    "contract_owner": "fap-web measurement governance",
    "authority_roles": {
      "fap_api_cms": "Owns edge identity, eligibility, relation, locale and target canonical truth; it is not a click-telemetry recipient in v1.",
      "fap_web": "Validates the public projection, renders the exact canonical href and dispatches only the approved payload after analytics consent.",
      "ga4": "Receives an aggregate browser observation only; the event is not a key event.",
      "backend_analytics": "No v1 forwarding. The generic /api/track transport is prohibited because it adds path and anonymous or session context."
    },
    "dispatch_policy": {
      "consent_required": "analytics_granted_at_activation_time",
      "unknown_or_denied": "hard_stop",
      "queue_before_consent": false,
      "replay_after_consent": false,
      "transport": "ga4_browser_only",
      "backend_forwarding": false,
      "dedup_key": "edge_id|source_surface|display_region|position_bucket|target_action",
      "dedup_window_ms": 2000,
      "retry": "none",
      "idempotency": "One fire-and-forget GA4 dispatch per accepted activation after client dedup; do not generate a user, anonymous, session or event identifier."
    },
    "key_event_policy": {
      "eligible": false,
      "reason": "A navigation observation is not a conversion or outcome and has no causal or revenue authority."
    },
    "destination_policy": {
      "href": "exact backend-approved target_canonical",
      "tracking_parameters_in_href": false,
      "tracking_parameters_in_canonical_identity": false,
      "slug_or_url_inference": false
    },
    "semantic_allowlists": {
      "locale": ["en", "zh-CN"],
      "source_surface": ["article", "content_page", "personality_profile", "topic"],
      "target_surface": ["article", "content_page", "personality_profile", "topic"],
      "relation_type": ["breadcrumb", "learn_more", "take_assessment"],
      "display_region": ["public_topic_edges"],
      "position_bucket": ["first", "early", "middle", "late"],
      "target_action": ["open_public_edge"],
      "entry_surface": ["article_detail", "content_page_detail", "personality_detail", "topic_detail"],
      "organic_channel": ["direct", "organic_search", "internal_navigation", "unknown"]
    },
    "edge_click_event_defined_by_m06": true,
    "runtime_callsite_present": true,
    "telemetry_sent": false,
    "consent_behavior_changed": false,
    "required_fields": [
      "edge_id",
      "locale",
      "source_surface",
      "target_surface",
      "relation_type",
      "display_region",
      "position_bucket",
      "target_action"
    ],
    "optional_fields": [
      "entry_surface",
      "organic_channel"
    ],
    "additional_properties": false,
    "forbidden_fields": [
      "user_identifier",
      "anonymous_identifier",
      "session_identifier",
      "attempt_identifier",
      "report_identifier",
      "order_identifier",
      "payment_identifier",
      "payment_data",
      "token",
      "email",
      "phone",
      "full_url",
      "slug",
      "query_string",
      "fragment",
      "referrer",
      "answer",
      "question_level_data",
      "score",
      "free_text",
      "error_stack"
    ]
  },
  "implementation_pr": {
    "id": "PUBLIC-TOPIC-GRAPH-RENDERER-01",
    "repo": "fap-web",
    "title": "PUBLIC-TOPIC-GRAPH-RENDERER-01: render and track backend-authoritative public topic edges",
    "runtime_surfaces": ["article_detail", "personality_detail", "topic_detail"],
    "content_page_runtime_deferred_without_matching_numeric_authority_id": true,
    "deployment_proven": false,
    "depends_on": [
      "PUBLIC-TOPIC-GRAPH-AUTHORITY-CONTRACT-01 merged",
      "G03 authority alignment PR #3605 merged",
      "approved backend fixture",
      "approved Measurement M06 contract",
      "Career C06 for Career rendering",
      "Program Controller manifest registration"
    ]
  }
}
