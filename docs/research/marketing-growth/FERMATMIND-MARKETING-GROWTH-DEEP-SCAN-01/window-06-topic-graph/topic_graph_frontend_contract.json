{
  "schema_version": "fermatmind.public_topic_edge_renderer.proposal.v1",
  "status": "PUBLIC_TOPIC_GRAPH_IMPLEMENTATION_READY_NOT_STARTED",
  "design_only": true,
  "authority": "consume fap-api public API only",
  "rendering": {
    "SSR_visible_HTML": true,
    "deterministic": "same validated payload yields byte-stable ordered anchor structure",
    "ordering": "preserve backend position then stable identity tiebreaker",
    "no_slug_inference": true,
    "no_local_mapping": true,
    "no_editorial_copy": true,
    "empty_payload": "render no module or minimal non-editorial shell",
    "api_error": "explicitly unavailable/no module; never pretend success",
    "canonical_hreflang_metadata_unchanged": true,
    "tracking_parameters_excluded_from_canonical": true,
    "locale_mismatch_fail_closed": true,
    "private_target_fail_closed": true,
    "career_gate": "do not render until current C06 passes"
  },
  "validation": [
    "deterministic order",
    "duplicate edge",
    "invalid relation",
    "missing target",
    "inactive target",
    "unqualified target",
    "locale mismatch",
    "private target",
    "empty API",
    "API timeout",
    "no local fallback",
    "safe tracking payload",
    "tracking query absent from canonical",
    "Career gate",
    "server-rendered visible links"
  ],
  "tracking_requirement": {
    "status": "M06_PUBLIC_TOPIC_EDGE_CLICK_CONTRACT_APPROVED_NOT_DEPLOYED",
    "m06_source": "window-02-measurement/event_contract.json",
    "m06_contract_status": "APPROVED_CONTRACT_ONLY_NOT_DEPLOYED",
    "event_name": "public_topic_edge_click",
    "observation_class": "browser_observation",
    "trigger_semantics": "A user activates a rendered public edge that was approved and issued by the backend authority.",
    "edge_click_event_defined_by_m06": true,
    "runtime_callsite_present": false,
    "telemetry_sent": false,
    "consent_behavior_changed": false,
    "required_fields": [
      "edge_id",
      "locale",
      "source_surface",
      "target_surface",
      "relation_type",
      "display_region",
      "position_bucket",
      "target_action"
    ],
    "optional_fields": [
      "entry_surface",
      "organic_channel"
    ],
    "additional_properties": false,
    "forbidden_fields": [
      "user_identifier",
      "anonymous_identifier",
      "session_identifier",
      "attempt_identifier",
      "report_identifier",
      "order_identifier",
      "payment_identifier",
      "payment_data",
      "token",
      "email",
      "phone",
      "full_url",
      "slug",
      "query_string",
      "fragment",
      "referrer",
      "answer",
      "question_level_data",
      "score",
      "free_text",
      "error_stack"
    ]
  },
  "implementation_pr": {
    "id": "PUBLIC-TOPIC-GRAPH-RENDERER-01",
    "repo": "fap-web",
    "title": "PUBLIC-TOPIC-GRAPH-RENDERER-01: render and track backend-authoritative public topic edges",
    "depends_on": [
      "PUBLIC-TOPIC-GRAPH-AUTHORITY-CONTRACT-01 merged",
      "approved backend fixture",
      "approved Measurement M06 contract",
      "Career C06 for Career rendering",
      "Program Controller manifest registration"
    ]
  }
}
