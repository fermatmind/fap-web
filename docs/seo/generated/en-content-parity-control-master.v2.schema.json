{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fermatmind.com/schemas/en-content-parity-control-master.v2.schema.json",
  "title": "FermatMind English content parity automation control V2",
  "oneOf": [
    { "$ref": "#/$defs/master" },
    { "$ref": "#/$defs/promotion_receipt" },
    { "$ref": "#/$defs/package_freeze_evidence" },
    { "$ref": "#/$defs/lane_manifest" },
    { "$ref": "#/$defs/control_inputs" }
  ],
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha256_or_null": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "content_status": {
      "enum": [
        "not_started",
        "inventory_frozen",
        "package_in_progress",
        "package_frozen",
        "qa_pass",
        "dry_run_ready",
        "draft_imported",
        "published",
        "live_qa_pass",
        "blocked"
      ]
    },
    "lane_manifest_status": {
      "enum": [
        "not_started",
        "inventory_frozen",
        "package_in_progress",
        "package_frozen",
        "qa_pass",
        "dry_run_ready"
      ]
    },
    "release_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cms_draft_import",
        "public_publish",
        "live_qa",
        "seo_discoverability",
        "production_deploy"
      ],
      "properties": {
        "cms_draft_import": { "const": "auto_after_dry_run_pass" },
        "public_publish": { "const": "auto_after_import_readback_pass" },
        "live_qa": { "const": "automatic" },
        "seo_discoverability": { "const": "separate_gate" },
        "production_deploy": { "const": "separate_exact_sha_gate" }
      }
    },
    "lineage": {
      "type": "object",
      "required": [
        "status",
        "evidence_owner_lane_id",
        "report_ref",
        "report_sha256",
        "package_sha256",
        "accepted_at"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/content_status" },
        "evidence_owner_lane_id": { "type": "string" },
        "report_ref": { "type": "string", "minLength": 1 },
        "report_sha256": { "$ref": "#/$defs/sha256" },
        "package_sha256": { "$ref": "#/$defs/sha256" },
        "accepted_at": { "type": "string", "format": "date-time" },
        "legacy_source": { "enum": ["v1_human_approval_audit_only", "v1_pre_v2_materialization_audit_only"] },
        "transition_dependency_allowed": { "const": false }
      },
      "additionalProperties": false
    },
    "lane_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_status", "to_status", "evidence_ref", "evidence_sha256", "recorded_at"],
      "properties": {
        "from_status": { "$ref": "#/$defs/lane_manifest_status" },
        "to_status": { "$ref": "#/$defs/lane_manifest_status" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "status",
        "blocked_from_status",
        "package_sha256",
        "qa_report_ref",
        "gate_lineage",
        "legacy_lineage",
        "promotion_receipts",
        "lane_manifest_ref",
        "release_policy"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/content_status" },
        "blocked_from_status": {
          "anyOf": [{ "$ref": "#/$defs/content_status" }, { "type": "null" }]
        },
        "package_sha256": { "$ref": "#/$defs/sha256_or_null" },
        "qa_report_ref": { "type": ["string", "null"] },
        "gate_lineage": { "type": "array", "items": { "$ref": "#/$defs/lineage" } },
        "legacy_lineage": { "type": "array", "items": { "$ref": "#/$defs/lineage" } },
        "promotion_receipts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "lane_manifest_ref": { "type": ["string", "null"] },
        "release_policy": {
          "anyOf": [{ "$ref": "#/$defs/release_policy" }, { "type": "null" }]
        }
      },
      "additionalProperties": true
    },
    "subscope": {
      "allOf": [
        { "$ref": "#/$defs/target" },
        {
          "type": "object",
          "required": ["id", "sequence", "resource", "asset_ids"],
          "properties": {
            "id": { "type": "string", "pattern": "^W[1-8]-[A-Z0-9-]+$" },
            "sequence": { "type": "integer", "minimum": 1 },
            "resource": { "type": "string", "minLength": 1 },
            "asset_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        }
      ]
    },
    "lane": {
      "allOf": [
        { "$ref": "#/$defs/target" },
        {
          "type": "object",
          "required": [
            "lane_id",
            "lane_kind",
            "launch_state",
            "counts",
            "subscopes",
            "output_directory",
            "dependencies",
            "blockers"
          ],
          "properties": {
            "lane_id": { "type": "string", "pattern": "^W[1-9]$" },
            "lane_kind": { "enum": ["producer", "independent_qa"] },
            "launch_state": { "type": "string" },
            "counts": {
              "type": "object",
              "required": [
                "cohort_count",
                "expected_en_assets",
                "current_en_assets",
                "remaining_en_assets",
                "unknown_inventory_cohorts"
              ]
            },
            "subscopes": { "type": "array", "items": { "$ref": "#/$defs/subscope" } },
            "output_directory": { "type": "string", "minLength": 1 },
            "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "blockers": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "promotion_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "receipt_kind",
        "result",
        "phase",
        "adapter",
        "lane",
        "subscope",
        "source_repository",
        "source_commit",
        "package_path",
        "package_sha256",
        "executor_release_sha256",
        "release_policy_sha256",
        "workflow_run_id",
        "workflow_run_attempt",
        "idempotency_key",
        "expected_count",
        "written_count",
        "readback_count",
        "published_count",
        "previous_receipt_sha256",
        "rollback_reference",
        "locale_check",
        "cjk_leakage_check",
        "identity_check",
        "privacy_redaction",
        "private_payload_read_count",
        "server_topology_exposed",
        "indexability_mutation_count",
        "sitemap_mutation_count",
        "llms_mutation_count",
        "search_mutation_count",
        "deploy_mutation_count",
        "receipt_content_sha256"
      ],
      "properties": {
        "schema_version": { "const": "fermatmind.content_promotion_receipt.v2" },
        "receipt_kind": {
          "enum": ["cms_draft_import_receipt", "cms_publication_receipt", "cms_live_qa_receipt"]
        },
        "result": { "const": "SUCCEEDED" },
        "phase": { "enum": ["draft-import", "publish", "live-qa"] },
        "adapter": { "type": "string", "pattern": "^[a-z0-9_]{1,96}$" },
        "lane": { "type": "string", "pattern": "^W[1-8]$" },
        "subscope": { "type": ["string", "null"] },
        "source_repository": { "const": "fermatmind/fap-api" },
        "source_commit": { "$ref": "#/$defs/sha1" },
        "package_path": {
          "type": "string",
          "pattern": "^(content_assets/en-content-parity|content_packs|content_baselines|database/seeders/data)/"
        },
        "package_sha256": { "$ref": "#/$defs/sha256" },
        "executor_release_sha256": { "$ref": "#/$defs/sha256" },
        "release_policy_sha256": { "$ref": "#/$defs/sha256" },
        "workflow_run_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "workflow_run_attempt": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "$ref": "#/$defs/sha256" },
        "expected_count": { "type": "integer", "minimum": 1 },
        "written_count": { "type": "integer", "minimum": 0 },
        "readback_count": { "type": "integer", "minimum": 1 },
        "published_count": { "type": "integer", "minimum": 0 },
        "previous_receipt_sha256": { "$ref": "#/$defs/sha256_or_null" },
        "rollback_reference": { "type": ["string", "null"] },
        "locale_check": { "const": "PASS" },
        "cjk_leakage_check": { "const": "PASS" },
        "identity_check": { "const": "PASS" },
        "privacy_redaction": { "const": true },
        "private_payload_read_count": { "const": 0 },
        "server_topology_exposed": { "const": false },
        "indexability_mutation_count": { "const": 0 },
        "sitemap_mutation_count": { "const": 0 },
        "llms_mutation_count": { "const": 0 },
        "search_mutation_count": { "const": 0 },
        "deploy_mutation_count": { "const": 0 },
        "receipt_content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "package_freeze_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schema_version",
        "artifact_kind",
        "lane_id",
        "subscope_id",
        "expected_count",
        "promotion_row_count",
        "asset_ids",
        "package_root",
        "package_manifest_ref",
        "package_manifest_sha256",
        "record_identity_field",
        "record_ids_sha256",
        "payloads",
        "package_sha256"
      ],
      "properties": {
        "$schema": { "const": "./en-content-parity-control-master.v2.schema.json" },
        "schema_version": { "const": "fermatmind.en_content_parity_package_freeze.v2" },
        "artifact_kind": { "const": "package_freeze_evidence" },
        "lane_id": { "type": "string", "pattern": "^W[1-8]$" },
        "subscope_id": { "type": ["string", "null"] },
        "expected_count": { "type": "integer", "minimum": 1 },
        "promotion_row_count": { "type": "integer", "minimum": 1 },
        "asset_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "package_root": { "type": "string", "pattern": "^generated/en-content-parity/" },
        "package_manifest_ref": { "type": "string", "pattern": "^generated/en-content-parity/.+/sha256_manifest\\.json$" },
        "package_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "record_identity_field": { "const": "asset_id" },
        "record_ids_sha256": { "$ref": "#/$defs/sha256" },
        "payloads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "row_count"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "row_count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "package_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "lane_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schema_version",
        "artifact_kind",
        "lane_id",
        "subscope",
        "status",
        "blocked_from_status",
        "package_sha256",
        "qa_report_ref",
        "gate_lineage",
        "legacy_lineage",
        "blockers",
        "transition_trace",
        "reviewed_source_commit",
        "expected_count"
        ,"promotion_row_count"
        ,"backend_package_sha256"
        ,"w9_review_binding_ref"
        ,"w9_review_binding_sha256"
        ,"external_package_evidence_ref"
        ,"external_package_evidence_sha256"
      ],
      "properties": {
        "$schema": { "const": "./en-content-parity-control-master.v2.schema.json" },
        "schema_version": { "const": "fermatmind.en_content_parity_lane_manifest.v2" },
        "artifact_kind": { "const": "lane_manifest" },
        "lane_id": { "type": "string", "pattern": "^W[1-8]$" },
        "subscope": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/lane_manifest_status" },
        "blocked_from_status": { "anyOf": [{ "$ref": "#/$defs/content_status" }, { "type": "null" }] },
        "package_sha256": { "$ref": "#/$defs/sha256_or_null" },
        "qa_report_ref": { "type": ["string", "null"] },
        "gate_lineage": { "type": "array", "items": { "$ref": "#/$defs/lineage" } },
        "legacy_lineage": { "type": "array", "items": { "$ref": "#/$defs/lineage" } },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "transition_trace": { "type": "array", "items": { "$ref": "#/$defs/lane_transition" } },
        "reviewed_source_commit": { "anyOf": [{ "type": "string", "pattern": "^[a-f0-9]{40}$" }, { "type": "null" }] },
        "expected_count": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }
        ,"promotion_row_count": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }
        ,"backend_package_sha256": { "$ref": "#/$defs/sha256_or_null" }
        ,"w9_review_binding_ref": { "type": ["string", "null"] }
        ,"w9_review_binding_sha256": { "$ref": "#/$defs/sha256_or_null" }
        ,"external_package_evidence_ref": { "type": ["string", "null"] }
        ,"external_package_evidence_sha256": { "$ref": "#/$defs/sha256_or_null" }
        ,"asset_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "control_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "schema_version", "artifact_kind", "lane_manifests", "receipt_chains"],
      "properties": {
        "$schema": { "const": "./en-content-parity-control-master.v2.schema.json" },
        "schema_version": { "const": "fermatmind.en_content_parity_control_inputs.v2" },
        "artifact_kind": { "const": "control_materialization_inputs" },
        "lane_manifests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lane_id", "subscope", "path", "sha256"],
            "properties": {
              "lane_id": { "type": "string", "pattern": "^W[1-8]$" },
              "subscope": { "type": ["string", "null"] },
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "receipt_chains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lane_id",
              "subscope",
              "target_status",
              "package_sha256",
              "expected_count",
              "release_policy_sha256",
              "receipt_paths"
            ],
            "properties": {
              "lane_id": { "type": "string", "pattern": "^W[1-8]$" },
              "subscope": { "type": ["string", "null"] },
              "target_status": { "enum": ["draft_imported", "published", "live_qa_pass"] },
              "package_sha256": { "$ref": "#/$defs/sha256" },
              "expected_count": { "type": "integer", "minimum": 1 },
              "release_policy_sha256": { "$ref": "#/$defs/sha256" },
              "receipt_paths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "master": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schema_version",
        "artifact_kind",
        "control_id",
        "is_master",
        "generated_at",
        "authority",
        "migration",
        "materialization",
        "state_machine",
        "release_policy_template",
        "qa_policy",
        "receipt_contract",
        "baseline",
        "existing_state_reference",
        "launch_policy",
        "handoff_contract",
        "lanes",
        "assets",
        "guardrails",
        "repository_rule_impact"
      ],
      "properties": {
        "$schema": { "const": "./en-content-parity-control-master.v2.schema.json" },
        "schema_version": { "const": "fermatmind.en_content_parity_control.v2" },
        "artifact_kind": { "const": "generated_read_only_master" },
        "control_id": { "const": "EN-PARITY-CONTROL-AUTOMATION-V2-01" },
        "is_master": { "const": true },
        "generated_at": { "type": "string" },
        "authority": { "type": "object" },
        "migration": { "type": "object" },
        "materialization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputs_path", "inputs_sha256", "lane_manifest_count", "receipt_chain_count"],
          "properties": {
            "inputs_path": { "const": "docs/seo/generated/en-content-parity-control-inputs.v2.json" },
            "inputs_sha256": { "$ref": "#/$defs/sha256" },
            "lane_manifest_count": { "type": "integer", "minimum": 0 },
            "receipt_chain_count": { "type": "integer", "minimum": 0 }
          }
        },
        "state_machine": {
          "type": "object",
          "required": ["ordered_states", "blocked_state", "skip_transitions_allowed", "state_control_pr_required"],
          "properties": {
            "ordered_states": {
              "const": [
                "not_started",
                "inventory_frozen",
                "package_in_progress",
                "package_frozen",
                "qa_pass",
                "dry_run_ready",
                "draft_imported",
                "published",
                "live_qa_pass"
              ]
            },
            "blocked_state": { "const": "blocked" },
            "skip_transitions_allowed": { "const": false },
            "state_facts_source": { "const": "lane_manifests_and_trusted_backend_receipts" },
            "state_control_pr_required": { "const": false }
          },
          "additionalProperties": false
        },
        "release_policy_template": { "$ref": "#/$defs/release_policy" },
        "qa_policy": { "type": "object" },
        "receipt_contract": { "type": "object" },
        "baseline": { "type": "object" },
        "existing_state_reference": { "type": "object" },
        "launch_policy": { "type": "object" },
        "handoff_contract": { "type": "object" },
        "lanes": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/lane" } },
        "assets": { "type": "array", "minItems": 8 },
        "guardrails": { "type": "object" },
        "repository_rule_impact": { "type": "object" }
      }
    }
  }
}
